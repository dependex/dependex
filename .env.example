# ==============================================================================
# UNIVERSAL COMMERCE & PAYPAL CONFIGURATION - EXAMPLE TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your real credentials. Never commit .env!

# PayPal REST API Credentials (obtain from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=live # or sandbox
PAYPAL_CURRENCY=EUR
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Commerce Core Settings
COMMERCE_ENV=production # or development
COMMERCE_BASE_URL=https://dependex.social
COMMERCE_DEFAULT_BUSINESS=biz_dependex
COMMERCE_ADMIN_KEY=change_this_to_a_secure_admin_key
COMMERCE_ALLOW_CORS=true
